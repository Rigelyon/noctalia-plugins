--!nonstrict
-- Generator for ~/.config/hypr/hypr-monitors.lua with Automatic Backup
local layoutMath = require("./layout_math.luau")

local config = {}

function config.getConfigPath(): string
  local path = nil
  if noctalia and noctalia.getConfig then
    path = noctalia.getConfig("config_path")
  end
  if not path or path == "" then
    path = "~/.config/hypr/hypr-monitors.lua"
  end
  if noctalia and noctalia.expandPath then
    return noctalia.expandPath(path)
  end
  return path
end

-- Formats a single monitor rule into Hyprland Lua syntax (hl.monitor)
function config.formatRule(m: layoutMath.Monitor): string
  if m.disabled then
    return string.format('hl.monitor({\n    output   = "%s",\n    disabled = true,\n})', m.name)
  end

  local rate = m.refreshRate or 60.0
  local rateStr = (math.abs(rate - math.floor(rate)) < 0.005)
    and string.format("%d", math.floor(rate + 0.5))
    or string.format("%.2f", rate)
  local res = string.format("%dx%d@%s", m.width or 1920, m.height or 1080, rateStr)
  local pos = string.format("%dx%d", m.x or 0, m.y or 0)
  local scaleStr = tostring(m.scale or 1.0)
  if string.sub(scaleStr, -2) == ".0" then
    scaleStr = string.sub(scaleStr, 1, -3)
  end

  local lines = {
    "hl.monitor({",
    string.format('    output   = "%s",', m.name),
    string.format('    mode     = "%s",', res),
    string.format('    position = "%s",', pos),
    string.format('    scale    = %s,', scaleStr),
  }

  if m.mirrorOf and m.mirrorOf ~= "" and m.mirrorOf ~= "none" then
    table.insert(lines, string.format('    mirror   = "%s",', m.mirrorOf))
  end
  if m.transform and m.transform > 0 then
    table.insert(lines, string.format('    transform = %d,', m.transform))
  end
  if m.vrr and m.vrr > 0 then
    table.insert(lines, string.format('    vrr      = %d,', m.vrr))
  end

  table.insert(lines, "})")
  return table.concat(lines, "\n")
end

-- Generates the complete header and body for hypr-monitors.lua
function config.generateConfigContent(monitors: { layoutMath.Monitor }): string
  local timeStr = ""
  if noctalia and noctalia.formatTime then
    timeStr = noctalia.formatTime("%Y-%m-%d %H:%M:%S")
  end

  local lines = {
    "---@module 'hl'",
    "-- -----------------------------------------------------------------------------",
    "-- Auto-generated by Noctalia Hyprland Monitor Manager",
    "-- Updated: " .. timeStr,
    "-- Ensure 'pcall(require, \"hypr-monitors\")' is in your ~/.config/hypr/hyprland.lua",
    "-- -----------------------------------------------------------------------------",
    "",
  }

  for _, m in ipairs(monitors) do
    table.insert(lines, config.formatRule(m))
    table.insert(lines, "")
  end

  return table.concat(lines, "\n")
end

-- Writes hypr-monitors.lua with .bak backup and triggers hyprctl reload
function config.writeConfig(monitors: { layoutMath.Monitor }): (boolean, string?)
  if not noctalia or not noctalia.writeFile then
    return false, "Noctalia filesystem API unavailable"
  end

  local targetPath = config.getConfigPath()

  -- Create automatic backup if file currently exists
  if noctalia.fileExists and noctalia.fileExists(targetPath) and noctalia.readFile then
    local currentContent, _ = noctalia.readFile(targetPath)
    if currentContent and currentContent ~= "" then
      noctalia.writeFile(targetPath .. ".bak", currentContent)
    end
  end

  local newContent = config.generateConfigContent(monitors)
  local ok, err = noctalia.writeFile(targetPath, newContent)
  if ok and noctalia and noctalia.runAsync then
    noctalia.runAsync({ "hyprctl", "reload" }, function(_) end)
  end
  return ok, err
end

-- Checks if hypr-monitors.lua is sourced / required in hyprland.lua or hyprland.conf
function config.isSourcedInHyprlandConf(): boolean
  if not noctalia or not noctalia.readFile or not noctalia.expandPath then
    return true
  end

  local luaPath = noctalia.expandPath("~/.config/hypr/hyprland.lua")
  if noctalia.fileExists and noctalia.fileExists(luaPath) then
    local content, _ = noctalia.readFile(luaPath)
    if content and string.find(content, "hypr%-monitors") then
      return true
    end
  end

  local confPath = noctalia.expandPath("~/.config/hypr/hyprland.conf")
  if noctalia.fileExists and noctalia.fileExists(confPath) then
    local content, _ = noctalia.readFile(confPath)
    if content and (string.find(content, "hypr%-monitors") or string.find(content, "monitors%.conf")) then
      return true
    end
  end

  return false
end

return config
